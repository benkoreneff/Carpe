# Generated by `make gen` from project.yml
Carpe.xcodeproj/

# Build output and the disk images from scripts/release.sh. The names end in
# .noindex so that Spotlight doesn't list the copies of Carpe.app inside.
build.noindex/
dist.noindex/
DerivedData/
*.xcuserstate
xcuserdata/

.DS_Store

# Google OAuth client downloads. Secrets belong in the Keychain, never in the repo.
client_secret*.json
